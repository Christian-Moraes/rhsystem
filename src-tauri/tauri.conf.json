{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RH System Desktop",
  "version": "0.1.0",
  "identifier": "com.rhsystem.desktop",
  "build": {
    "beforeBuildCommand": "cd ../frontend && npm run build:desktop",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RH System Desktop",
        "width": 1280,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
