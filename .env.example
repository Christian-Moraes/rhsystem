# Copie para .env e preencha os valores.
# cp .env.example .env

# Groq (obrigatório para importar folha de ponto por imagem)
# Crie uma chave grátis em https://console.groq.com/keys (login > API Keys > Create API Key)
# e cole abaixo. Nunca versione o .env.
GROQ_API_KEY=

# Opcional: modelo de visão (default: qwen/qwen3.8-27b)
# GROQ_MODEL=qwen/qwen3.8-27b
# Modelo de raciocínio (fallback): openai/gpt-oss-120b
# GROQ_THINKING_MODEL=openai/gpt-oss-120b
